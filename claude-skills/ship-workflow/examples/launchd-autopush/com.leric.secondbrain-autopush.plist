<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/leric</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>Label</key>
	<string>com.leric.secondbrain-autopush</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/open</string>
		<string>-g</string>
		<string>-j</string>
		<string>-W</string>
		<string>/Users/leric/Applications/SecondBrainAutopush.app</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>/Users/leric/Library/Logs/secondbrain-autopush.stderr.log</string>
	<key>StandardOutPath</key>
	<string>/Users/leric/Library/Logs/secondbrain-autopush.stdout.log</string>
	<key>StartInterval</key>
	<integer>21600</integer>
</dict>
</plist>
